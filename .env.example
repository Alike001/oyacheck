# Public configuration only. Copy locally; no private key or seed is accepted.
# This file is not auto-loaded. Export values via the process environment.
OYACHECK_READ_ONLY=1
BUY_BROWSER_SANDBOX=0
OYACHECK_DEMO_BROWSER=0
OYACHECK_MAINNET_PREPARE=0
OYACHECK_MAINNET_EXECUTE=0
# Owner-confirmed public address; does not enable signing or configure buy.
OYACHECK_AGENT_WALLET=0x9Ceaa6aBFb2bC1aC202f96496Cdc683d86Bc458a
# Existing backend-only buy account and independently verified payer. These
# remain separate from the ERC-8004 owner/receiving wallet until verified.
OYACHECK_BUY_ACCOUNT=
OYACHECK_BUY_PAYER=
OYACHECK_BUY_TOKEN=USDC
# Local durable ledger only; absolute path required. Unset for hosted release.
OYACHECK_PURCHASE_DB=
